# --- Database: CockroachDB Serverless (Postgres wire protocol) ---
# Get this from the Cockroach Cloud console's Connect panel, but change
# its default sslmode=verify-full to sslmode=require -- verify-full needs
# a CA cert file (~/.postgresql/root.crt) that Render/local dev don't have.
DATABASE_URL=

# --- Worker auth ---
# Shared secret for the X-Tick-Token header -- cron-job.org sends this,
# worker/main.py compares it constant-time. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TICK_TOKEN=
# seconds between exit-guard stop/target passes in the worker; 0 disables
EXIT_GUARD_SECONDS=10

# --- LLM provider (factory picks the class from this at runtime) ---
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=
# Only needed if LLM_PROVIDER is switched away from nvidia:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- CoinDCX ---
# Trade permission only -- NEVER grant withdrawal permission to this key.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# --- Firebase Authentication ---
# Web API key, from Firebase Console -> Project Settings -> General ->
# Web API Key. Used for the REST sign-in call from Streamlit.
FIREBASE_WEB_API_KEY=
# Whole service-account key JSON file's contents as one value (not a
# path) -- Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. Used by firebase-admin to verify ID tokens.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated list of emails allowed to sign in -- anyone else's
# Firebase account, even if valid, is refused at the app layer.
ALLOWED_EMAILS=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Wallets (seed_wallets.py reads these for the two default wallets) ---
WALLET_SMALL_STARTING_CAPITAL=1000
WALLET_LARGE_STARTING_CAPITAL=5000
DEATH_THRESHOLD_PCT=20
